# Backend production environment for https://api.daytrip.ie
# Copy to /home/api.daytrip.ie/app/.env on the VPS and fill in the blanks.
# Never commit the real file.

APP_NAME=Daytrip
APP_ENV=production
APP_KEY=                      # generated by: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.daytrip.ie

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL on the same VPS. Do NOT set DB_URL (it overrides the values below).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=daytrip
DB_USERNAME=daytrip
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database     # needs the queue worker service, see deploy/DEPLOY.md

# The SPA origin: used for CORS and the password-reset link in emails.
# Exactly ONE origin, no trailing slash (redirect www -> daytrip.ie in CyberPanel).
FRONTEND_URL=https://daytrip.ie

# Mail: use an external SMTP provider (Contabo blocks port 25 and its IPs are often spam-listed).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="booking@daytrip.ie"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOTIFICATION_EMAIL=booking@daytrip.ie

# Stripe (live keys). Webhook endpoint: https://api.daytrip.ie/api/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_SETUP_AMOUNT=0
