# Backend production environment for https://daytrip.ie (the site serves both the React app and the API under /api)
# Copy to /home/daytrip.ie/app/.env on the VPS and fill in the blanks.
# Never commit the real file or put real keys in this example.

APP_NAME=Daytrip
APP_ENV=production
APP_KEY=                      # generated by: php artisan key:generate
APP_DEBUG=false               # must stay false in production
APP_URL=https://daytrip.ie

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL on the same VPS. Do NOT set DB_URL (it overrides the values below).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=daytrip
DB_USERNAME=daytrip
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database     # needs the queue worker service, see deploy/DEPLOY.md
CACHE_STORE=database

# The site origin: used for the password-reset link in emails (and CORS).
# Exactly ONE origin, no trailing slash.
FRONTEND_URL=https://daytrip.ie

# Mail via Brevo SMTP (Contabo blocks port 25 and its IPs are often spam-listed).
# Username and password are the SMTP login/key from Brevo -> SMTP & API.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="booking@daytrip.ie"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOTIFICATION_EMAIL=booking@daytrip.ie

# Stripe. Use live keys (sk_live_... / pk_live_...) in production.
# Webhook endpoint: https://daytrip.ie/api/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# SumUp — backend-only. SUMUP_SETUP_AMOUNT is the EUR amount on the checkout
# that saves a card (0 saves it without charging).
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_SETUP_AMOUNT=0
