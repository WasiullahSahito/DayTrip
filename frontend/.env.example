# Base URL of the Laravel API (no trailing slash).
VITE_API_URL=http://localhost:8000/api

# Stripe PUBLISHABLE key only — never put the secret key here. Anything
# prefixed VITE_ is bundled into the client-side build and publicly visible.
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API key, restricted (in the Google Cloud Console)
# to this app's origin(s) and to the Maps JavaScript/Places/Geocoding APIs.
# Leave blank to fall back to the built-in mock Dublin address book — real
# autocomplete/geocoding only activates once this is set.
VITE_GOOGLE_MAPS_API_KEY=
